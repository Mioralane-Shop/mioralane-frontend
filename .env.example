# Mioralane storefront — environment template.
#
# Copy it and fill in what you need (`.env` / `.env.local` are gitignored, and
# `.env.local` wins — see the load order in the Next.js docs):
#
#     cp .env.example .env.local
#
# Every variable here is `NEXT_PUBLIC_*`, which Next.js INLINES AT BUILD TIME
# rather than reading at runtime — so a deployed change needs a rebuild, not a
# restart. All of them are read defensively, so a build with none of them set
# still succeeds; that is what CI proves (.github/workflows/ci.yml).
# Nothing in this app is secret: everything prefixed `NEXT_PUBLIC_` is shipped
# to the browser.

# Base URL of the API, INCLUDING the `/api` prefix.
#   - src/lib/axios.ts    — request base URL. Unset means same-origin requests.
#   - src/middleware.ts   — added to the CSP `connect-src` allowlist.
# Development value; production is the deployed API origin.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth client id, used by src/providers/google-auth-provider.tsx.
# Must be the same client the API verifies with its `GOOGLE_CLIENT_ID`.
# Unset disables Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. URL that receives CSP violation reports — the `report-uri` of the
# Report-Only policy built in src/middleware.ts. Unset sends no reports, which is
# the current state (no collector exists yet); setting it is how a report-only
# window is actually observed.
CSP_REPORT_URI=

# Cloudflare Turnstile site key (PUBLIC — it ships to the browser by design).
# The matching SECRET is server-side only, in mioralane-backend's
# TURNSTILE_SECRET_KEY; never put it here (nor anywhere prefixed NEXT_PUBLIC_).
# Unset disables the widget, and the client-side gate fails open.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here